<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      This example consumes the published NuGet package, exactly as an
      out-of-repo consumer would. The package version tracks the Dagger
      engine version it was generated against (engine v0.21.7 ->
      0.21.7-preview).

      For in-repo development against unreleased SDK changes, swap in a
      project reference instead:
        <ProjectReference Include="..\..\src\Dagger.SDK\Dagger.SDK.csproj" />
    -->
    <PackageReference Include="DaggerIO" Version="0.21.7-preview.1" />
  </ItemGroup>
</Project>
